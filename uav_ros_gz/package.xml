<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>uav_ros_gz</name>
  <version>0.1.0</version>
  <description>Simulation interface for UAVs using ROS 2 and Gazebo</description>
  <maintainer email="hello@juliordz.com">Julio Rodriguez</maintainer>
  <license>Apache 2.0</license>

  <author>Julio Rodriguez</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>uav_gz</exec_depend>
  <exec_depend>uav_controller</exec_depend>
  <exec_depend>uav_bringup</exec_depend>
  <exec_depend>uav_estimators</exec_depend>
  <exec_depend>uav_perception</exec_depend>
  <exec_depend>uav_tools</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
