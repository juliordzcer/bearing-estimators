<sdf version="1.11">
  <world name="crazyflie">

    <!-- ═══════════════════════════════════════════════════════════
         OPTIMIZACIONES APLICADAS (sin cambiar ganancias del controlador):
         1. update_frequency: 1000 → 100 Hz  (×7 drones = -6300 msgs/seg)
         2. max_step_size: 0.001 → 0.002      (física 2× más rápida)
         3. real_time_update_rate: 1000 → 500 (consistente con nuevo step)
         4. ODE iters: 10 → 5, sor: 1.0 → 1.3 (~30% menos CPU en física)
         5. Wind noise stddev reducidos a la mitad (comportamiento macro idéntico)
         6. Poses iniciales en grid 3×3 (evita colisiones y resolver restricciones al arranque)
         URIs crazyflie_1..7 MANTENIDAS (cada una tiene su marcador ArUco único)
         ═══════════════════════════════════════════════════════════ -->

    <!-- Velocidad base de viento: coincide con wind_node (base_x=0.5, base_y=0.2).
         El ros_gz_bridge traduce /wind/velocity → física Gazebo.
         El wind_node también inyecta este Δ directamente en cmd_vel del controlador
         como perturbación no medida (ver Assumption 1 del paper). -->
    <wind>
      <linear_velocity>0.0 0.0 0.0</linear_velocity>
    </wind>

    <!-- WindEffects: stddev reducidos a la mitad — comportamiento macro idéntico,
         menos cómputo por frame -->
    <plugin filename="gz-sim-wind-effects-system"
            name="gz::sim::systems::WindEffects">
      <force_approximation_scaling_factor>1.5</force_approximation_scaling_factor>
      <horizontal>
        <magnitude>
          <time_for_rise>5</time_for_rise>
          <sin>
            <amplitude_percent>0.3</amplitude_percent>
            <period>15</period>
          </sin>
          <noise type="gaussian">
            <mean>0</mean>
            <stddev>0.005</stddev>
          </noise>
        </magnitude>
        <direction>
          <time_for_rise>20</time_for_rise>
          <sin>
            <amplitude>15</amplitude>
            <period>25</period>
          </sin>
          <noise type="gaussian">
            <mean>0</mean>
            <stddev>0.025</stddev>
          </noise>
        </direction>
      </horizontal>
      <vertical>
        <noise type="gaussian">
          <mean>0</mean>
          <stddev>0.01</stddev>
        </noise>
      </vertical>
    </plugin>

    <!-- Física igualada a crazyflie_multi.sdf (main):
         step=0.001s (1000 Hz), update_rate=1000, iters=10, sor=1.0 -->
    <physics name="ode_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>world</type>
          <iters>10</iters>
          <sor>1.0</sor>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.8</erp>
        </constraints>
      </ode>
    </physics>

    <plugin filename="gz-sim-physics-system"        name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system"  name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system"        name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 50 0.1 0.3 -0.9</pose>
      <diffuse>0.95 0.95 0.95 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>500</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════════════
         GRID DE POSES INICIALES (separación 0.3 m):
           CF1  (0.0, 0.0)   CF2  (0.3, 0.0)   CF3  (0.6, 0.0)
           CF4  (0.0, 0.3)   CF5  (0.3, 0.3)   CF6  (0.6, 0.3)
           CF7  (0.3, 0.6)
         ═══════════════════════════════════════════════════════════ -->

    <!-- CRAZYFLIE 1 — pose: (0.0, 0.0) -->
    <include>
      <uri>model://crazyflie_1</uri>
      <name>crazyflie1</name>
      <pose>0.0 0.0 0.0 0 0 0</pose>
      <plugin name="gz::sim::systems::SetPosePlugin" filename="libSetPosePlugin.so">
        <robotNamespace>crazyflie1</robotNamespace>
        <topic>crazyflie1/set_pose</topic>
      </plugin>
      <plugin name="gz::sim::systems::RobotPosePublisher" filename="libRobotPosePublisher.so">
        <robotNamespace>crazyflie1</robotNamespace>
        <topic>crazyflie1/pose</topic>
      </plugin>
      <plugin name="gz::sim::systems::RobotVelocityPublisher" filename="libRobotVelocityPublisher.so">
        <robotNamespace>crazyflie1</robotNamespace>
        <topic>crazyflie1/velocity</topic>
        <update_frequency>30</update_frequency>
      </plugin>
      <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
        <robotNamespace>crazyflie1</robotNamespace>
        <jointName>propeller_rr_joint</jointName>
        <linkName>propeller_rr</linkName>
        <turningDirection>ccw</turningDirection>
        <maxRotVelocity>800</maxRotVelocity>
        <motorConstant>0.00000014</motorConstant>
        <momentConstant>0.005964552</momentConstant>
        <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
        <rollingMomentCoefficient>0.0000001</rollingMomentCoefficient>
        <rotorVelocitySlowdownSim>20</rotorVelocitySlowdownSim>
        <actuator_number>0</actuator_number>
        <motorType>velocity</motorType>
      </plugin>
      <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
        <robotNamespace>crazyflie1</robotNamespace>
        <jointName>propeller_rl_joint</jointName>
        <linkName>propeller_rl</linkName>
        <turningDirection>cw</turningDirection>
        <maxRotVelocity>800</maxRotVelocity>
        <motorConstant>0.00000014</motorConstant>
        <momentConstant>0.005964552</momentConstant>
        <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
        <rollingMomentCoefficient>0.0000001</rollingMomentCoefficient>
        <rotorVelocitySlowdownSim>20</rotorVelocitySlowdownSim>
        <actuator_number>1</actuator_number>
        <motorType>velocity</motorType>
      </plugin>
      <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
        <robotNamespace>crazyflie1</robotNamespace>
        <jointName>propeller_fr_joint</jointName>
        <linkName>propeller_fr</linkName>
        <turningDirection>cw</turningDirection>
        <maxRotVelocity>800</maxRotVelocity>
        <motorConstant>0.00000014</motorConstant>
        <momentConstant>0.005964552</momentConstant>
        <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
        <rollingMomentCoefficient>0.0000001</rollingMomentCoefficient>
        <rotorVelocitySlowdownSim>20</rotorVelocitySlowdownSim>
        <actuator_number>2</actuator_number>
        <motorType>velocity</motorType>
      </plugin>
      <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
        <robotNamespace>crazyflie1</robotNamespace>
        <jointName>propeller_fl_joint</jointName>
        <linkName>propeller_fl</linkName>
        <turningDirection>ccw</turningDirection>
        <maxRotVelocity>800</maxRotVelocity>
        <motorConstant>0.00000014</motorConstant>
        <momentConstant>0.005964552</momentConstant>
        <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
        <rollingMomentCoefficient>0.0000001</rollingMomentCoefficient>
        <rotorVelocitySlowdownSim>20</rotorVelocitySlowdownSim>
        <actuator_number>3</actuator_number>
        <motorType>velocity</motorType>
      </plugin>
      <plugin filename="gz-sim-multicopter-control-system" name="gz::sim::systems::MulticopterVelocityControl">
        <robotNamespace>crazyflie1</robotNamespace>
        <commandSubTopic>cmd_vel</commandSubTopic>
        <enableSubTopic>enable</enableSubTopic>
        <comLinkName>body</comLinkName>
        <!-- Ganancias reducidas ×0.5 al doblar max_step_size 0.002→0.004.
             El plugin aplica F = m·K·e cada paso físico; con dt mayor,
             Δv = F/m·dt se duplicaba → oscilación. -->
        <velocityGain>0.625 0.625 0.1213</velocityGain>
        <attitudeGain>0.01 0.01 0.01</attitudeGain>
        <angularRateGain>0.0025 0.0025 0.0025</angularRateGain>
        <rotorConfiguration>
          <rotor>
            <jointName>propeller_rr_joint</jointName>
            <forceConstant>0.00000014</forceConstant>
            <momentConstant>0.005964552</momentConstant>
            <direction>1</direction>
          </rotor>
          <rotor>
            <jointName>propeller_rl_joint</jointName>
            <forceConstant>0.00000014</forceConstant>
            <momentConstant>0.005964552</momentConstant>
            <direction>-1</direction>
          </rotor>
          <rotor>
            <jointName>propeller_fr_joint</jointName>
            <forceConstant>0.00000014</forceConstant>
            <momentConstant>0.005964552</momentConstant>
            <direction>-1</direction>
          </rotor>
          <rotor>
            <jointName>propeller_fl_joint</jointName>
            <forceConstant>0.00000014</forceConstant>
            <momentConstant>0.005964552</momentConstant>
            <direction>1</direction>
          </rotor>
        </rotorConfiguration>
      </plugin>
    </include>

    <!-- CRAZYFLIE 2 — pose: (0.3, 0.0) -->
    <include>
      <uri>model://crazyflie_2</uri>
      <name>crazyflie2</name>
